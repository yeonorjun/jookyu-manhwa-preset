  const compressed = getExactCompressedData(buf);

  if (!compressed) {

    return {

      statusCode: 500,

      headers: { "Content-Type": "text/plain; charset=utf-8" },

      body: "Не удалось распознать структуру архива NovelAI."

    };

  }



  let png;

  try {

    png = zlib.inflateRawSync(compressed);

  } catch (e) {

    return {

      statusCode: 500,

      headers: { "Content-Type": "text/plain; charset=utf-8" },

      body: "Ошибка распаковки архива: " + e.message

    };

  }



  return {

    statusCode: 200,

    headers: { "Content-Type": "image/png", "Access-Control-Allow-Origin": "*" },

    isBase64Encoded: true,

    body: png.toString("base64")

  };

};



function getExactCompressedData(buf) {

  let eocdIndex = -1;

  for (let i = buf.length - 22; i >= 0; i--) {

    if (buf[i] === 0x50 && buf[i+1] === 0x4b && buf[i+2] === 0x05 && buf[i+3] === 0x06) {

      eocdIndex = i;

      break;

    }

  }

  if (eocdIndex === -1) return null;



  const cdOffset = buf.readUInt32LE(eocdIndex + 16);



  if (buf[0] !== 0x50 || buf[1] !== 0x4b || buf[2] !== 0x03 || buf[3] !== 0x04) return null;



  const flags = buf.readUInt16LE(6);

  const hasDataDescriptor = (flags & 8) !== 0;

  const nameLen = buf.readUInt16LE(26);

  const extraLen = buf.readUInt16LE(28);



  const dataStart = 30 + nameLen + extraLen;

  let dataEnd = cdOffset;



  if (hasDataDescriptor) {

    if (buf[cdOffset - 16] === 0x50 && buf[cdOffset - 15] === 0x4b && buf[cdOffset - 14] === 0x07 && buf[cdOffset - 13] === 0x08) {

      dataEnd = cdOffset - 16;

    } else {

      dataEnd = cdOffset - 12;

    }

  }



  return buf.subarray(dataStart, dataEnd);

}
