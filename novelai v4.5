  }



  let aspectRatio = params.aspect_ratio || "3:2";

  let width = 1216, height = 832;

  if (aspectRatio === "1:1") { width = 1024; height = 1024; }

  else if (aspectRatio === "2:3") { width = 832; height = 1216; }

  else if (aspectRatio === "19:6" || aspectRatio === "16:9") { width = 1344; height = 768; }

  else if (aspectRatio === "6:19" || aspectRatio === "9:16") { width = 768; height = 1344; }



  // УСИЛЕННЫЙ НЕГАТИВ: анатомия + дефекты + артефакты

  const negPrompt = "lowres, bad anatomy, bad hands, bad feet, bad proportions, malformed limbs, mutated hands, poorly drawn hands, poorly drawn face, fused fingers, too many fingers, missing fingers, extra digit, fewer digits, extra limbs, extra arms, extra legs, missing arms, missing legs, long neck, cross-eyed, deformed, disfigured, mutated, mutilated, ugly, duplicate, morbid, gross proportions, bad body, text, error, cropped, out of frame, worst quality, low quality, normal quality, jpeg artifacts, signature, watermark, username, blurry, bad art, beginner, amateur";



  // Генерация с автоподрезкой промпта: полный → 1500 → 900 → 500 символов

  const limits = [prompt.length, 1500, 900, 500];



  let response = null, lastErr = "";

  outer:

  for (const lim of limits) {

    const p = prompt.slice(0, lim);

    const body = {

      input: p,

      model: "nai-diffusion-4-5-full",

      action: "generate",

      parameters: {

        width: width,

        height: height,

        scale: 6,

        sampler: "k_euler_ancestral",

