        },

        v4_negative_prompt: {

          caption: { base_caption: negPrompt, char_captions: [] },

          use_coords: false,

          use_order: true

        }

      }

    };



    // До 8 попыток при ошибке 429 (занятость сервиса)

    for (let attempt = 0; attempt < 8; attempt++) {

      const ctrl = new AbortController();

      const killer = setTimeout(() => ctrl.abort(), 90000);

      try {

        response = await fetch("https://image.novelai.net/ai/generate-image", {

          method: "POST",

          headers: {

            "Authorization": `Bearer ${NOVELAI_TOKEN}`,

            "Content-Type": "application/json",

            "Origin": "https://novelai.net",

