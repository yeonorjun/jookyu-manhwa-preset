const NAI_STYLE = "1.6::obj Shep::, 1.6::rella::, 1.9::fengjian yuzhi::, 0.4::kagoya1219 ::, 1.8::pigeon666 ::, 0.7::96yottea::, 0.8::aoma xuanzexuexi::, 0.5::vlfdus 0 ::, 0.8::kuby_hq::, 1.8::nocetus::, 2.0::cinematic filter::, lart art1, zero_q_0q, year 2025, 1.4::teeniika::, 1.7::dang0_23 ::, 1.4::mgong520 ::, 1.1::sanbonzakura::, 0.5::umikochannart::, bang dacy, 0.7::blackbox::, best quality, very aesthetic, adult characters, clean lineart, clean coloring, sharp focus, dramatic shadows, brushwork, 3: detailed eyes, detailed hair, detailed face::, 3::pale natural skin::, 2::no_watermark::, ";



const sleep = (ms) => new Promise(r => setTimeout(r, ms));



module.exports.handler = async function (event) {

  const params = event.queryStringParameters || {};



  // ПИНГ для диагностики (бесплатно, NovelAI не трогает)

  if (params.ping) {

